OPENROUTER_API_KEY=your-openrouter-key
TEMUCLAUDE_MASTER_KEY=generate-a-long-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API-key persistence. Required in production unless ALLOW_EPHEMERAL_DB=true
# is deliberately enabled for a temporary diagnostic deployment.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key
ALLOW_EPHEMERAL_DB=false
